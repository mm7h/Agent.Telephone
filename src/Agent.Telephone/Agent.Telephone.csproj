<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Title>Agent.Telephone</Title>
    <Description>通过 SIP/RTP 将传统电话接入 AI 语音 Agent 的 .NET SDK。Connect traditional telephones to AI voice agents over SIP/RTP.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Flurl.Http" />
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool.DependencyInjection" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Async" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="SIPSorcery" />
    <PackageReference Include="Websocket.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Agent.Telephone.Abstractions\Agent.Telephone.Abstractions.csproj" />
    <ProjectReference Include="..\media\Agent.Telephone.Abstractions\Agent.Telephone.Media.Abstractions.csproj" />
    <ProjectReference Include="..\media\Agent.Telephone.Media\Agent.Telephone.Media.csproj" />
    <ProjectReference Include="..\media\Agent.Telephone.Media.Resource\Agent.Telephone.Media.Resource.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Agent.Telephone.Tests" />
  </ItemGroup>

</Project>
